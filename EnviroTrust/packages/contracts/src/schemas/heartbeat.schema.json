{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envirotrust.local/contracts/heartbeat.schema.json",
  "title": "EnviroTrust Signed Sensor Heartbeat Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventType", "messageId", "sensorId", "keyId", "siteId", "stationId", "bootId", "heartbeatSequence", "sentAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventType": {"const": "HEARTBEAT"},
    "messageId": {"type": "string", "format": "uuid"},
    "sensorId": {"type": "string", "minLength": 3, "maxLength": 64},
    "keyId": {"type": "string", "minLength": 3, "maxLength": 64},
    "siteId": {"type": "string", "minLength": 3, "maxLength": 64},
    "stationId": {"type": "string", "minLength": 3, "maxLength": 64},
    "bootId": {"type": "string", "minLength": 8, "maxLength": 64},
    "heartbeatSequence": {"type": "integer", "minimum": 1},
    "sentAt": {"type": "string", "format": "date-time"}
  }
}
