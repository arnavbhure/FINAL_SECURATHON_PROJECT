{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed Tamper Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "$ref": "tamper-event.schema.json"
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 256,
      "contentEncoding": "base64"
    }
  }
}

