{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed Operations Context Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {"$ref": "ops-context.schema.json"},
    "signature": {"type": "string", "minLength": 80, "maxLength": 256, "contentEncoding": "base64"}
  }
}
