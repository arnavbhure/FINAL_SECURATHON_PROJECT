# EnviroTrust root/local orchestration example.
# Copy to the relevant service .env files as explained in ENVIRONMENT_SETUP.md.
# Never commit real .env files, passwords, tokens or private keys.

NODE_ENV=development
DEMO_MODE=true

# Primary Express API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://envirotrust_app:CHANGE_ME@localhost:5432/envirotrust_primary

# Authentication - replace with a unique random value
JWT_SECRET=REPLACE_WITH_RANDOM_48_BYTE_BASE64URL_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=envirotrust_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Primary ingestion freshness policy (prototype defaults, not regulatory requirements)
MAX_FUTURE_SKEW_SECONDS=120
MAX_TELEMETRY_AGE_SECONDS=300

# Independent witness process and separate database/credentials
WITNESS_PORT=4001
WITNESS_BASE_URL=http://localhost:4001
WITNESS_DATABASE_URL=postgresql://envirotrust_witness:CHANGE_ME@localhost:5432/envirotrust_witness
WITNESS_ID=WITNESS-001
WITNESS_DISPLAY_NAME=Simulated Independent Witness
WITNESS_CHECKPOINT_EVERY=10
WITNESS_KEY_DIR=./local-secrets/witness-keys
WITNESS_SERVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_INTERNAL_TOKEN

# ML service is implemented by the designated human teammate.
# Keep false until their FastAPI service is running and passes contract tests.
ML_ENABLED=true
ML_BASE_URL=http://10.159.158.109:8000
ML_TIMEOUT_MS=5000
ML_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN_SHARED_WITH_ML_SERVICE
ML_CONTEXT_WAIT_DEADLINE_SECONDS=60

# Local sensor and operations simulators (private keys remain simulator-side)
SENSOR_KEY_DIR=./local-secrets/sensor-keys
OPS_KEY_DIR=./local-secrets/ops-keys
SIMULATOR_TELEMETRY_INTERVAL_MS=7000
SIMULATOR_HEARTBEAT_INTERVAL_MS=10000
SIMULATOR_RETRY_COUNT=3
SIMULATOR_RETRY_BASE_MS=500
PRIMARY_INGESTION_URL=http://localhost:4000/api/v1/ingestion/readings
PRIMARY_HEARTBEAT_URL=http://localhost:4000/api/v1/ingestion/heartbeats
PRIMARY_OPS_INGESTION_URL=http://localhost:4000/api/v1/ingestion/operations-context
WITNESS_INGESTION_URL=http://localhost:4001/witness/v1/ingestion/readings
WITNESS_HEARTBEAT_URL=http://localhost:4001/witness/v1/ingestion/heartbeats

# Heartbeat monitoring
HEARTBEAT_MISSED_INTERVALS=3
HEARTBEAT_GRACE_SECONDS=5

# Demo seed users - use local-only passwords and never commit real values.
SEED_ADMIN_EMAIL=admin@envirotrust.local
SEED_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
SEED_OPERATOR_EMAIL=operator@envirotrust.local
SEED_OPERATOR_PASSWORD=CHANGE_ME_LOCAL_ONLY
SEED_OPERATOR_SITE_ID=PLANT-001
SEED_AUDITOR_EMAIL=auditor@envirotrust.local
SEED_AUDITOR_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Browser-only variables belong in apps/web/.env and must never contain secrets:
# VITE_API_BASE_URL=http://localhost:4000/api/v1
# VITE_DEMO_MODE=true

# ML service variables belong in services/ml/.env:
# ML_HOST=127.0.0.1
# ML_PORT=8000
# MODEL_PATH=./models/cod_model.joblib
# ML_RANDOM_SEED=42
# ML_LOG_LEVEL=INFO