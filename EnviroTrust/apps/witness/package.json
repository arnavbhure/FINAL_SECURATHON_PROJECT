{
  "name": "@envirotrust/witness",
  "version": "1.0.0",
  "private": true,
  "description": "EnviroTrust Simulated Independent Witness Service",
  "type": "module",
  "main": "./dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "predev": "node ../../scripts/ensure-deps.mjs",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "@envirotrust/contracts": "*",
    "@envirotrust/crypto": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  }
}
