# EnviroTrust Web Dashboard Configuration
# Base API paths (defaults to Vite proxy /api/v1 and /witness/v1 in development)
VITE_API_BASE_URL=/api/v1
VITE_WITNESS_BASE_URL=/witness/v1

# Demo mode gates pre-filled login shortcuts and demo credentials on the login screen.
# Defaults to false in production to prevent credential leakage.
VITE_DEMO_MODE=true

