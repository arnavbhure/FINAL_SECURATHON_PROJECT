# EnviroTrust Primary API Configuration Example
NODE_ENV=development
DEMO_MODE=true
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://envirotrust_app:CHANGE_ME@localhost:5432/envirotrust_primary

# Authentication
JWT_SECRET=REPLACE_WITH_RANDOM_48_BYTE_BASE64URL_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=envirotrust_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Freshness policy
MAX_FUTURE_SKEW_SECONDS=120
MAX_TELEMETRY_AGE_SECONDS=300

# Witness service
WITNESS_BASE_URL=http://localhost:4001
WITNESS_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_INTERNAL_TOKEN
INTERNAL_AUTH_SECRET=REPLACE_WITH_A_RANDOM_INTERNAL_AUTH_SECRET_MIN_32_CHARS

# ML Service Integration (Python FastAPI over local LAN or 127.0.0.1)
# Keep false until teammate's FastAPI service is running
ML_ENABLED=true
# Set to teammate LAN IP e.g. http://10.x.x.x:8000 when testing over LAN
ML_BASE_URL=http://10.159.158.109:8000
ML_TIMEOUT_MS=5000
ML_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN_SHARED_WITH_ML_SERVICE
ML_CONTEXT_WAIT_DEADLINE_SECONDS=60

# Attack Simulation Lab (demo-only; see docs/ATTACK_LAB.md). Never enable in production.
ATTACK_LAB_ENABLED=true
ATTACK_LAB_AUTHORIZED_ADMINS=admin@envirotrust.local
ATTACK_LAB_EXPECTED_PRIMARY_DB=envirotrust_primary
ATTACK_LAB_EXPECTED_WITNESS_DB=envirotrust_witness
ATTACK_LAB_ALLOW_PRIVATE_NETWORK_TARGETS=false
# Optional: independently obtained witness public-key fingerprint (64 hex chars) for scenario G
ATTACK_LAB_TRUSTED_WITNESS_FINGERPRINT=
